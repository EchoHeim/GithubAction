# 本地运行凭据模板
#
# 复制成 .env.local（已被 .gitignore 忽略，不会进仓库），填入真实值。
# 填运行器要用的那几项即可，用不到的可以删掉或留空。
#
# JQ_USERNAME / JQ_PASSWORD  —— 聚宽登录账号、密码，与 GitHub Secrets 里的一致
# FEISHU_BOT_ID             —— 飞书机器人 ID，与 GitHub Secrets 里的一致
# CHECKIN_HEADLESS          —— 填 1 则后台跑，不弹出浏览器窗口；留空则显示窗口

JQ_USERNAME=
JQ_PASSWORD=
FEISHU_BOT_ID=
CHECKIN_HEADLESS=1
