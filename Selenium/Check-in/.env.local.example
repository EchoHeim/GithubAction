# 本地运行凭据模板
#
# 复制成 .env.local（已被 .gitignore 忽略，不会进仓库），填入真实值。
# 只填你要跑的站点那几项即可，用不到的可以删掉或留空。
#
# JQ_USERNAME / JQ_PASSWORD           —— 聚宽账号密码，与 GitHub Secrets 里的一致
# PJ52_COOKIE                         —— 【52pojie 推荐】登录后的 Cookie，形如
#                                        `52pojie_xxxx_saltkey=...; 52pojie_xxxx_auth=...; 52pojie_xxxx_sid=...`
#                                        取法见 LOCAL_RUN.md。登录页有人机验证（Turnstile），
#                                        自动化过不去，**别指望用账号密码跑 52pojie**。
# JUEJIN_USERNAME / JUEJIN_PASSWORD   —— 【掘金】手机号/邮箱 + 密码；脚本会**自动过滑块验证码**
# JUEJIN_COOKIE                      —— 掘金可选兜底：填了且没给账号密码时，直接复用登录态
# FEISHU_BOT_ID                       —— 飞书机器人 ID，与 GitHub Secrets 里的一致（三个站点共用）
#
# 掘金签完会自动去**幸运抽奖**页读矿石数 + 免费抽一次（失败不影响签到结论）。
# 要关掉抽奖就设 JUEJIN_LOTTERY=0。
#
# 掘金抽完奖会再走一遍**沸点**：回首页 → 导航栏「沸点」→ 发一条沸点 + 给 2 名好友点赞
#（失败同样不影响签到结论）。默认**跑两遍**、两遍之间隔 120 秒；
# 第 2 轮文案自动加「（2）」后缀，避免与第一轮完全重复。
# 要关掉就设 JUEJIN_PINS=0；轮次/间隔/内容/点赞数：
#   JUEJIN_PINS_ROUNDS=2 / JUEJIN_PINS_GAP=120 / JUEJIN_PINS_TEXT / JUEJIN_PINS_LIKES
#
# 沸点跑完后还会去**文章详情页**：回首页点第 1 篇文章 → 左侧点赞 + 收藏（弹窗选默认收藏夹）
# + 右侧作者有关注按钮就点（已关注则忽略）；做完回首页点第 2 篇重复一遍。
# ⚠️ 文章在**新标签页**打开，脚本会自动切句柄、做完关标签回首页。
# 要关掉就设 JUEJIN_ARTICLE=0；篇数：JUEJIN_ARTICLE_COUNT=2。
#
# CHECKIN_HEADLESS      —— 填 1 则后台跑，不弹出浏览器窗口；留空则显示窗口
# CHECKIN_CHROMEDRIVER  —— 可选。指定现成的 chromedriver.exe 路径，
#                          绕开 Selenium Manager 联网取驱动的环节（本机安全策略会拦它）

JQ_USERNAME=
JQ_PASSWORD=
PJ52_COOKIE=
JUEJIN_COOKIE=
JUEJIN_USERNAME=
JUEJIN_PASSWORD=
# JUEJIN_LOTTERY=0
# JUEJIN_PINS=0
# JUEJIN_PINS_TEXT=今天也要好好写代码呀~
# JUEJIN_PINS_LIKES=2
# JUEJIN_PINS_ROUNDS=2
# JUEJIN_PINS_GAP=120
# JUEJIN_ARTICLE=0
# JUEJIN_ARTICLE_COUNT=2
FEISHU_BOT_ID=
CHECKIN_HEADLESS=1
