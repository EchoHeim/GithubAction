# 本地运行凭据模板
#
# 复制成 .env.local（已被 .gitignore 忽略，不会进仓库），填入真实值。
# 只填你要跑的站点那几项即可，用不到的可以删掉或留空。
#
# JQ_USERNAME / JQ_PASSWORD           —— 聚宽账号密码，与 GitHub Secrets 里的一致
# PJ52_COOKIE                         —— 【52pojie 推荐】登录后的 Cookie，形如
#                                        `52pojie_xxxx_saltkey=...; 52pojie_xxxx_auth=...; 52pojie_xxxx_sid=...`
#                                        取法见 LOCAL_RUN.md。登录页有人机验证（Turnstile），
#                                        自动化过不去，**别指望用账号密码跑 52pojie**。
# JUEJIN_USERNAME / JUEJIN_PASSWORD   —— 【掘金】手机号/邮箱 + 密码；脚本会**自动过滑块验证码**
# JUEJIN_COOKIE                      —— 掘金可选兜底：填了且没给账号密码时，直接复用登录态
# FEISHU_BOT_ID                       —— 飞书机器人 ID，与 GitHub Secrets 里的一致（三个站点共用）
#
# CHECKIN_HEADLESS      —— 填 1 则后台跑，不弹出浏览器窗口；留空则显示窗口
# CHECKIN_CHROMEDRIVER  —— 可选。指定现成的 chromedriver.exe 路径，
#                          绕开 Selenium Manager 联网取驱动的环节（本机安全策略会拦它）

JQ_USERNAME=
JQ_PASSWORD=
PJ52_COOKIE=
JUEJIN_COOKIE=
JUEJIN_USERNAME=
JUEJIN_PASSWORD=
FEISHU_BOT_ID=
CHECKIN_HEADLESS=1
